{
  "$schema": "http://json-schema.org/draft-07/schema",
  "$id": "https://github.com/mrfylke/frammr-mqtt-validator/specifications/validators/emv/kft/[deviceId]/abort/abort.schema.json",
  "title": "Abort EMV Payment Transaction",
  "type": "object",
  "description": "Request to abort the currently active EMV Known Fare Transaction (KFT) on the validator.",
  "properties": {
    "traceId": {
      "$id": "#/properties/traceId",
      "type": "string",
      "format": "uuid",
      "description": "Unique message identifier (UUID v4)."
    },
    "eventTimestamp": {
      "$id": "#/properties/eventTimestamp",
      "type": "string",
      "format": "date-time",
      "description": "Timestamp when the abort request was issued (UTC, RFC3339 format)."
    }
  },
  "required": [
    "traceId",
    "eventTimestamp"
  ],
  "additionalProperties": false
}
